# PC 联调模式：false = 走真实后端 pilipili-backend (Spring Boot :9090)
# VUE_APP_API_BASE=/api 由 vue.config.js 的 devServer.proxy 转发到 :9090，
# proxy 的 pathRewrite 会去掉 /api 前缀，后端 ApiPrefixFilter 会自动补回，两种写法都可用。
# 临时回到纯前端 mock 演示：把下面这项改回 true 并重启 devServer 即可（无需改任何业务代码）。
VUE_APP_USE_MOCK=false
VUE_APP_API_BASE=/api

# 实时能力占位：弹幕 / IM WebSocket 后端尚未接入，保持预留地址，暂不改动
VUE_APP_WS_DANMU_URL=ws://localhost:7070
VUE_APP_WS_IM_URL=ws://localhost:7071
